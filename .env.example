# Copy to .env before running: cp .env.example .env
APP_NAME=Personal AI Agent Platform
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-before-any-shared-deployment
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_dev_password
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# In-container service URLs are set by compose; these are fallbacks for local host runs.
DATABASE_URL=postgresql+asyncpg://agent:agent_dev_password@localhost:5433/agent_platform
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me
S3_BUCKET=agent-files
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me

MAX_UPLOAD_BYTES=20971520
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
EMBEDDING_DIMENSIONS=384
DEFAULT_RETRIEVAL_K=5

# Optional. Without this key, the Knowledge Agent returns retrieved passages as a preview.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Key for encrypting user BYOK API keys (Fernet 32-byte urlsafe base64 string)
BYOK_ENCRYPTION_KEY=GLOlVbtcECNRmO11TSNukqwW5-u5RMjOmDz7i-gL2G8=

# Research & External Tools
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=

# Jira / Project Tracking
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=

# IT Operations & Telemetry
PROMETHEUS_URL=http://localhost:9090

# Data Analyst Dedicated Read-Only Connection
READ_ONLY_DATABASE_URL=postgresql+asyncpg://agent_ro:readonly_password@localhost:5433/agent_platform

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
